{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Low-noise dependency updates for eumel8, eumelnet and mcsps",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-7 * * 1"],
  "updateNotScheduled": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 3,
  "automerge": false,
  "dependencyDashboard": true,
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Go archives used by release workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "https://(?:dl\\.google\\.com/go|go\\.dev/dl)/go(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.[a-z0-9-]+\\.tar\\.gz"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Bundle non-major Go module updates",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules"
    },
    {
      "description": "Bundle non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "Bundle non-major container image updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "container images"
    },
    {
      "description": "Keep Go build images, release archives and directives in one PR",
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": ["go", "golang", "docker.io/golang"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "go toolchain"
    },
    {
      "description": "Opt application repositories into updating their minimum Go version",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Create major upgrade PRs only when requested in the dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
